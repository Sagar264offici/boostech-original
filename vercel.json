{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/services/:path*", "destination": "/" },
    { "source": "/resources/:path*", "destination": "/" },
    { "source": "/contact", "destination": "/" },
    { "source": "/contact/", "destination": "/" }
  ]
}
